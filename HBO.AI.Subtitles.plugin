#!name = HBO AI Subtitles
#!desc = HBO Max 字幕：英文/CC 的 Gemini 翻译、独立缓存、共用 AppleTV VPS 外部字幕。默认保留官方中文；字幕需手动选择。实验版。
#!author = JerseyRiver
#!homepage = https://github.com/JerseyRiver/HBO-AI-Subtitles
#!version = 0.1.0
#!date = 2026-10-09
#!system = iOS,iPadOS

[Argument]
Mode = select,"Auto","Translate","External",tag=字幕模式,desc=Auto 有官方中文时保留原轨否则翻译英文；Translate 强制翻译英文；External 覆盖一个非强制字幕轨。外部模式需网关和影片信息。
Vendor = input,"Gemini",tag=翻译器,desc=使用 Gemini。
GeminiAPIKey = input,"",tag=Gemini API Key,desc=填写自己的 Key。
GeminiModel = input,"gemini-3.5-flash-lite",tag=Gemini 模型,desc=填写账号可用的精确模型 ID。
GeminiBatchSize = select,"400","300","600",tag=每批条数,desc=较大批次需要较长等待。
Languages[0] = input,"EN",tag=源语言,desc=此插件仅翻译识别出的完整英文轨。
Languages[1] = select,"ZH","ZH-HANS","ZH-HANT",tag=翻译目标语言,desc=设备端 Gemini 翻译的目标语言；网关外部字幕为简体中文。
Position = select,"Reverse","Forward",tag=双语位置,desc=Reverse 译文在上原文在下。
ShowOnly = switch,false,tag=只显示译文,desc=设备端翻译可保留中英双语。
LogLevel = select,"WARN","OFF","ERROR","INFO",tag=日志等级,desc=建议保持 WARN。
GatewayURL = input,"",tag=外部字幕网关,desc=共用升级后的 AppleTV VPS。填写 https://域名/v1/令牌；留空禁用。
Title = input,"",tag=外部字幕片名,desc=电影英文原名或剧集英文剧名。当前抓包无详情元数据故需填写；换片必须更新。
Year = input,"",tag=年份,desc=电影发行年份或剧集首播年份。
MediaType = select,"movie","tv",tag=影片类型,desc=剧集选 tv 并填写季集。
Season = input,"",tag=季数,desc=剧集必填。
Episode = input,"",tag=集数,desc=剧集必填；每次换集需更新。
OffsetSeconds = input,"0",tag=外部字幕校时秒数,desc=正数延后负数提前。仅对外部字幕生效；不会自动冒用 Apple 的 CC 校时。

[Script]
http-request ^https:\/\/(?:[^\/?#]+\.e\.hbo|[^\/?#]+\.media\.max\.com|[^\/?#]+\.media\.h264\.io)\/__hbo_ai__\/[a-f0-9-]{36}\/playlist\.m3u8(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/HBO-AI-Subtitles/main/scripts/HBO.Subtitles.js, timeout=10, tag=HBO AI Virtual Playlist, argument=[{Mode},{GatewayURL},{Title},{Year},{MediaType},{Season},{Episode},{OffsetSeconds}]
http-response ^https:\/\/default\.any-any\.prd\.api\.discomax\.com\/playback-orchestrator\/any\/playback-orchestrator\/v1\/playbackInfo(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/HBO-AI-Subtitles/main/scripts/HBO.Subtitles.js, requires-body=1, timeout=10, tag=HBO AI Playback Context, argument=[{Mode},{GatewayURL},{Title},{Year},{MediaType},{Season},{Episode},{OffsetSeconds}]
http-response ^https:\/\/(?:[^\/?#]+\.e\.hbo|[^\/?#]+\.media\.max\.com|[^\/?#]+\.media\.h264\.io)\/[^?#]+\.m3u8(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/HBO-AI-Subtitles/main/scripts/HBO.Subtitles.js, requires-body=1, timeout=20, tag=HBO AI HLS Subtitles, argument=[{Mode},{GatewayURL},{Title},{Year},{MediaType},{Season},{Episode},{OffsetSeconds}]
http-response ^https:\/\/(?:[^\/?#]+\.e\.hbo|[^\/?#]+\.media\.max\.com|[^\/?#]+\.media\.h264\.io)\/[^?#]+\.(?:vtt|webvtt)(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/HBO-AI-Subtitles/main/scripts/HBO.Translate.response.bundle.js, requires-body=1, timeout=60, tag=HBO AI Translate, argument=[{Vendor},{GeminiAPIKey},{GeminiModel},{GeminiBatchSize},{Languages[0]},{Languages[1]},{Position},{ShowOnly},{LogLevel}]

[MITM]
hostname = default.any-any.prd.api.discomax.com, *.e.hbo, *.media.max.com, *.media.h264.io
