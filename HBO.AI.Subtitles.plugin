#!name = HBO AI Subtitles
#!desc = HBO Max 字幕：官方中文优先，可获取字幕时 AI 翻译，否则 VPS 外部字幕；每次只添加一种选项。
#!author = JerseyRiver
#!homepage = https://github.com/JerseyRiver/HBO-AI-Subtitles
#!version = 0.4.0
#!date = 2026-10-09
#!system = iOS,iPadOS

[Argument]
QualityCompatibility = switch,false,tag=保留旧最高画质逻辑,desc=原来使用 HBO iPad Highest Quality 时可开启；此时停用旧最高画质插件，避免规则抢先匹配。
GeminiAPIKey = input,"",tag=Gemini API Key,desc=填写自己的 Key。
GeminiModel = input,"gemini-3.5-flash-lite",tag=Gemini 模型,desc=填写账号可用的精确模型 ID。
Languages[1] = select,"ZH","ZH-HANS","ZH-HANT",tag=翻译目标语言,desc=设备端 Gemini 翻译的目标语言；网关外部字幕为简体中文。
Position = select,"Reverse","Forward",tag=双语位置,desc=Reverse 译文在上原文在下。
ShowOnly = switch,false,tag=只显示译文,desc=设备端翻译可保留中英双语。
GatewayURL = input,"",tag=外部字幕网关,desc=共用升级后的 AppleTV VPS。填写 https://域名/v1/令牌；留空禁用。
OffsetSeconds = input,"0",tag=外部字幕校时秒数,desc=正数延后负数提前。仅对外部字幕生效；不会自动冒用 Apple 的 CC 校时。

[Script]
http-request ^https:\/\/default\.any-any\.prd\.api\.discomax\.com\/playback-orchestrator\/any\/playback-orchestrator\/v1\/playbackInfo(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/HBO-AI-Subtitles/main/scripts/HBO.Playback.request.js, requires-body=1, timeout=10, tag=HBO Optional Quality Request, argument=[{QualityCompatibility}]
http-request ^https:\/\/(?:[^\/?#]+\.e\.hbo|[^\/?#]+\.media\.max\.com|[^\/?#]+\.media\.h264\.io)\/__hbo_ai__\/[a-f0-9-]{36}\/ai\/\d+\/seg-\d+\.vtt(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/HBO-AI-Subtitles/main/scripts/HBO.Translate.response.bundle.js, timeout=60, tag=HBO Independent AI Translate, argument=[{GeminiAPIKey},{GeminiModel},{Languages[1]},{Position},{ShowOnly}]
http-request ^https:\/\/(?:[^\/?#]+\.e\.hbo|[^\/?#]+\.media\.max\.com|[^\/?#]+\.media\.h264\.io)\/__hbo_ai__\/[a-f0-9-]{36}\/(?:ai|external)\/\d+\/playlist\.m3u8(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/HBO-AI-Subtitles/main/scripts/HBO.Subtitles.js, timeout=20, tag=HBO Independent Subtitle Playlist, argument=[{GatewayURL},{OffsetSeconds},{QualityCompatibility}]
http-response ^https:\/\/default\.[a-z0-9-]+\.prd\.api\.discomax\.com\/cms\/ script-path=https://raw.githubusercontent.com/JerseyRiver/HBO-AI-Subtitles/main/scripts/HBO.Compatible.response.js, requires-body=1, timeout=10, tag=HBO Metadata, argument=[{GatewayURL},{OffsetSeconds},{QualityCompatibility}]
http-response ^https:\/\/default\.any-any\.prd\.api\.discomax\.com\/playback-orchestrator\/any\/playback-orchestrator\/v1\/playbackInfo(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/HBO-AI-Subtitles/main/scripts/HBO.Compatible.response.js, requires-body=1, timeout=20, tag=HBO Playback Options, argument=[{GatewayURL},{OffsetSeconds},{QualityCompatibility}]
http-response ^https:\/\/(?:[^\/?#]+\.e\.hbo|[^\/?#]+\.media\.max\.com|[^\/?#]+\.media\.h264\.io)\/[^?#]+\.m3u8(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/HBO-AI-Subtitles/main/scripts/HBO.Compatible.response.js, requires-body=1, timeout=30, tag=HBO HLS Options and Quality, argument=[{GatewayURL},{OffsetSeconds},{QualityCompatibility}]

[MITM]
hostname = default.*.prd.api.discomax.com, *.e.hbo, *.media.max.com, *.media.h264.io
